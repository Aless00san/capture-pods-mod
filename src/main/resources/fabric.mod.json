{
  "schemaVersion": 1,
  "id": "capture-pods",
  "version": "${version}",
  "name": "Capture Pods",
  "description": "Adds a secure way to transport mobs, depending on open parties and claims for securing your mobs.",
  "authors": [
    "AlpacaSama"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "license": "CC0-1.0",
  "icon": "assets/capture-pods/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.alpaca.capturepods.CapturePods"
    ],
    "fabric-datagen": [
      "net.alpaca.capturepods.CapturePodsDataGenerator"
    ]
  },
  "mixins": [
    "capture-pods.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.11",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-api": "*"
  },
  "suggests": {
    "another-mod": "*"
  }
}